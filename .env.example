# Modelo de variáveis de ambiente do Vinum.
# Copie para .env.local (no PowerShell: Copy-Item .env.example .env.local) e ajuste os valores.
# NUNCA coloque segredos neste arquivo: ele vai para o Git.
# Variáveis com prefixo NEXT_PUBLIC_ ficam visíveis no navegador: use só para valores públicos.

# URL pública do site, usada em canonical, Open Graph e sitemap (sem barra no final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Carrega os dados de demonstração (src/data/demo). Use "true" só em desenvolvimento.
# Em produção deve ser "false": o validador de dados bloqueia dados demo publicados.
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# --- Fase 9 (mapas) - ainda não utilizado ---
# URL do estilo do mapa (pública), conforme o provedor escolhido no ADR-015.
# NEXT_PUBLIC_MAP_STYLE_URL=
# Chave privada do provedor de tiles, somente se o provedor exigir e só no servidor.
# MAP_TILES_API_KEY=
